# Live BKK/FUTAR searches
BKK_API_KEY=
BKK_API_BASE_URL=https://futar.bkk.hu/api/query/v1/ws
BKK_API_DIALECT=mobile
BKK_API_VERSION=2
BKK_API_TIMEOUT_SECONDS=5

# Optional PostgreSQL persistence. Enable after creating the source schema.
USE_POSTGRES=false
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=bkk
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SCHEMA=transit_data
POSTGRES_SSLMODE=prefer
POSTGRES_CONNECT_TIMEOUT_SECONDS=8

# Optional warehouse analytics. Uses Application Default Credentials.
USE_BIGQUERY=false
GCP_PROJECT_ID=
BIGQUERY_DATASET=bkk_dw
